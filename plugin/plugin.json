{
  "name": "karpathy-wiki",
  "description": "Karpathy-style LLM Knowledge Base v3 — persistent, self-maintaining wiki with sleep-time compute (Letta-style) and auto skill creation (Hermes-style GEPA loop).",
  "version": "3.1.0",
  "author": "pi-user",
  "license": "MIT",
  "homepage": "https://github.com/forrestchang/andrej-karpathy-skills",
  "platforms": ["claude-code", "pi", "hermes", "codex", "opencode", "kilocode", "antigravity"],
  "install_guide": "See INSTALL.md for per-CLI installation instructions.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "cat ~/.local/share/ai-wiki/pages/index.md 2>/dev/null | head -60",
            "timeout": 5,
            "description": "Inject wiki index into session context"
          },
          {
            "type": "command",
            "command": "cat ~/.local/share/ai-wiki/.meta/skills/*.md 2>/dev/null | head -40 || true",
            "timeout": 5,
            "description": "Inject auto-generated skill references"
          },
          {
            "type": "command",
            "command": "bash -lc 'root=\"${WIKI_MEMORY_ROOT:-$HOME/code/wiki-memory}\"; MEMORY_SOURCE=claude-code python3 \"$root/hooks/memory_hook.py\" session-start 2>/dev/null || true'",
            "timeout": 8,
            "description": "Recall atomic memories from prior sessions into context"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash -lc 'root=\"${WIKI_MEMORY_ROOT:-$HOME/code/wiki-memory}\"; MEMORY_SOURCE=claude-code MEMORY_HOOK_STRUCTURED=1 python3 \"$root/hooks/memory_hook.py\" user-prompt 2>/dev/null || true'",
            "timeout": 8,
            "description": "Save explicit 'remember…' directives and surface relevant memories"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash -lc 'root=\"${WIKI_MEMORY_ROOT:-$HOME/code/wiki-memory}\"; python3 \"$root/dream/dream_agent.py\" --quiet --idle 60 2>/dev/null || true'",
            "timeout": 30,
            "description": "Run dream agent before compaction (sleep-time compute, 60s budget)"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash -lc 'root=\"${WIKI_MEMORY_ROOT:-$HOME/code/wiki-memory}\"; MEMORY_SOURCE=claude-code python3 \"$root/hooks/memory_hook.py\" session-end 2>/dev/null || true'",
            "timeout": 10,
            "description": "Capture atomic memories from the session transcript"
          },
          {
            "type": "command",
            "command": "bash -lc 'root=\"${WIKI_MEMORY_ROOT:-$HOME/code/wiki-memory}\"; python3 \"$root/dream/dream_agent.py\" --quiet 2>/dev/null' &",
            "timeout": 2,
            "description": "Fire-and-forget dream cycle on session end"
          }
        ]
      }
    ]
  },
  "skills": ["skill/SKILL.md"],
  "agentConfig": {
    "target": "~/.pi/agent/AGENTS.md",
    "injectAt": "end"
  }
}
